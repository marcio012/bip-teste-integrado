<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
  <persistence-unit name="ejbPU" transaction-type="JTA">
    <class>com.example.ejb.entity.Beneficio</class>
    <!-- Se for usar servidor de app com DataSource JNDI, troque para jta-data-source -->
    <!-- <jta-data-source>java:/jdbc/BipDS</jta-data-source> -->

    <!-- Execução local de teste sem servidor (com Hibernate): -->
    <properties>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/bip"/>
      <property name="jakarta.persistence.jdbc.user" value="bip"/>
      <property name="jakarta.persistence.jdbc.password" value="bip"/>
      <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.format_sql" value="true"/>
    </properties>
  </persistence-unit>
</persistence>